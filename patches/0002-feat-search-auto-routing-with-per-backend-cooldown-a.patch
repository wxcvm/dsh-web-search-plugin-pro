-		const provider = options.provider;
-		const restInstance = this.rest.get(provider);
+	/**
+	 * `auto` routing: first backend that returns results wins. A backend that
+	 * throws (quota, auth, rate limit, network) is cooled down instead of
+	 * failing the call, so one dead engine never costs the model a turn.
+	 */
+	async searchAuto(options, request, signal) {
+		const failures = [];
+		const now = Date.now();
+		for (const id of options.autoOrder ?? []) {
+			const backend = this.backendFor(id);
+			if (backend === void 0 || !backend.available()) continue;
+			if ((this.cooldownUntil.get(id) ?? 0) > now) {
+				failures.push(`${id}: cooling down`);
+				continue;
+			}
+			try {
+				const result = await backend.search(request, signal);
+				if (result.sources.length > 0) {
+					this.cooldownUntil.delete(id);
+					return result;
+				}
+				failures.push(`${id}: no results`);
+			} catch (error) {
+				if (signal?.aborted === true) throw error;
+				this.cooldownUntil.set(id, Date.now() + (options.autoCooldownMs ?? 60000));
+				failures.push(`${id}: ${error instanceof Error ? error.message : String(error)}`);
+			}
+		}
+		throw new WebError(`auto search found no usable backend (${failures.join("; ") || "none available"})`, "WEB_PROVIDER_ERROR");
+	}
+
+	/** Resolve one backend id to its instance (`auto` walks this). */

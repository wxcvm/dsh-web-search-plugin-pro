-		// Fallback: provider points at something unknown → official default.
-		return this.deepseek;
+		if (id === "deepseek-official") return this.deepseek;
+		return void 0;
+	}
+
+	backend() {
+		// Fallback: an unknown provider id routes to the official default.
+		return this.backendFor(this.resolveOptions().provider) ?? this.deepseek;
+	}
+}
